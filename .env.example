# Copy to .env (local) or add these as environment variables on your host (Render etc.).
# Add at least one free key. Without keys, Copilot uses scripted answers from the engine.

# Google Gemini (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Blank = Google's rolling alias "gemini-flash-latest", then gemini-2.5-flash fallbacks.
GEMINI_MODEL=

# Groq (free): https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Blank = openai/gpt-oss-120b, then openai/gpt-oss-20b.
GROQ_MODEL=

# Which provider Copilot starts with: gemini | groq | offline (switchable in the Copilot panel)
LLM_PROVIDER=gemini
LLM_TIMEOUT_SECONDS=25

# Optional: pin "today" so the demo date (30 Nov 2026) stays valid after it passes
# DEMO_TODAY=2026-10-04
